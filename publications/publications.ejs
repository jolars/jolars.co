```{=html}
<ul class="list publication-list" reversed>
  <% for (const item of items) { %>
    <li <%=metadataAttrs(item) %>>
      <span class="listing-title fw-bold"><%= item.title %></span></br>
      <p>
        <span class="listing-author">
          <%= item.author %>
        </span>
        </br>
        <% if (item.citation.type == 'journal-article') { %>
          <% if (item.citation["container-title"]) { %>
            <span class="listing-publication fst-italic">
              item.citation["container-title"] %>
            </span>,
          <% } %>
          <% if (item.citation.volume) { %>
            <span class="listing-volume">
              vol.&nbsp;<%= item.citation.volume %>
            </span>,
          <% } %>
          <% if (item.citation.number) { %>
            <span class="listing-number">
              no.&nbsp;<%= item.citation.number %>
            </span>,
          <% } %>
          <% if (item.citation.page) { %>
            <span class="listing-pages">
              pp.&nbsp;<%= item.citation.page %>
            </span>
          <% } %>
          <span class="listing-date">, <%= item.citation.date %></span>.
        <% } %>
        <% if (item.citation.type == 'article-journal') { %>
          <% if (item.citation["container-title"]) { %>
            <span class="listing-publication fst-italic"><%= item.citation["container-title"] %></span>,
          <% } %>
          <% if (item.citation["volume"]) { %>
            <span class="listing-volume"><%= item.citation["volume"] %></span><% } %><% if (item.citation["issue"]) { %><span class="listing-issue">(<%= item.citation["issue"] %>)</span>,
          <% } %>
          <% if (item.citation["page"]) { %>
            <span class="listing-page"><%= item.citation["page"] %></span>,
          <% } %>
          <% if (item.citation.publisher) { %>
            <span class="listing-archive fst-italic"><%= item.citation.publisher %></span>,
          <% } %>
          <span class="listing-date"><%= item.date %></span>.
        <% } %>
        <% if (item.citation.type == 'article') { %>
          <% if (item.citation["container-title"]) { %>
            <span class="listing-publication fst-italic"><%= item.citation["container-title"] %></span>,
          <% } %>
          <% if (item.citation.publisher) { %>
            <span class="listing-archive fst-italic"><%= item.citation.publisher %></span>,
          <% } %>
          <span class="listing-date"><%= item.date %></span>.
        <% } %>
        <% if (item.citation.type == 'paper-conference') { %>
          <% if (item.citation["container-title"]) { %>
            In <span class="listing-publication fst-italic"><%= item.citation["container-title"] %></span>,
          <% } %>
          <% if (item.citation["event-place"]) { %>
            <span class="listing-details"><%= item.citation["event-place"] %></span>,
          <% } %>
          <span class="listing-date"><%= item.date %></span>,
          <% if (item.citation.volume) { %>
            <span class="listing-publication-volume">vol.&nbsp;<%= item.citation.volume %></span>,
          <% } %>
          <% if (item.citation.number) { %>
            <span class="listing-publication-number">no.&nbsp;<%= item.citation.number %></span>,
          <% } %>
          <% if (item.citation.page) { %>
            <span class="listing-publication-pages">pp.&nbsp;<%= item.citation.page %></span>.
          <% } %>
        <% } %>
        <% if (item.citation.type == 'thesis') { %>
          <% if (item.citation["container-title"]) { %>
            In <span class="listing-publication fst-italic"><%= item.citation["container-title"] %></span>,
          <% } %>
          <% if (item.citation.genre) { %>
            <span class="listing-publication-genre"><%= item.citation.genre %></span>,
          <% } %>
          <% if (item.citation["publisher"]) { %>
            <span class="listing-details"><%= item.citation.publisher %></span>,
          <% } %>
          <span class="listing-date"><%= item.date %></span>,
        <% } %>
        </br>
        <span class="citation-links">
          <a href="<%= item.path %>" class="citation-link-primary">
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i>Details
          </a>
          <% if (item.doi) { %>
            <a href="https://doi.org/<%= item.doi %>" class="citation-link-success">
              <i class="fa-solid fa-link" aria-hidden="true"></i>DOI
            </a>
          <% } %>
          <% if (item.url) { %>
            <a href="<%= item.url %>" class="citation-link-success">
              <i class="fa-solid fa-link" aria-hidden="true"></i>URL
            </a>
          <% } %>
          <% if (item.pdf) {
            const pdfPath = /^(?:https?:)?\//.test(item.pdf)
              ? item.pdf
              : item.path.substring(0, item.path.lastIndexOf('/') + 1) + item.pdf;
          %>
            <a href="<%= pdfPath %>" class="citation-link-warning">
              <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>PDF
            </a>
          <% } %>
          <% if (item.arxiv) { %>
            <a href="https://arxiv.org/abs/<%= item.arxiv %>" class="citation-link-danger">
              <i class="ai ai-arxiv" aria-hidden="true"></i>arXiv
            </a>
          <% } %>
          <% if (item.github) { %>
            <a href="https://github.com/<%= item.github %>" class="citation-link-dark">
              <i class="fa fa-github" aria-hidden="true"></i>Code
            </a>
          <% } %>
          <% if (item.bitbucket) { %>
            <a href="https://bitbucket.com/<%= item.bitbucket %>" class="citation-link-dark">
              <i class="fa fa-bitbucket" aria-hidden="true"></i>Code
            </a>
          <% } %>
          <% if (item.cran) { %>
            <a href="https://CRAN.R-project.org/package=<%= item.cran %>" class="citation-link-info">
              <i class="fab fa-r-project" aria-hidden="true"></i>CRAN
            </a>
          <% } %>
          <% if (item.pypi) { %>
            <a href="https://pypi.org/project/<%= item.pypi %>" class="citation-link-info">
              <i class="fa-brands fa-python" aria-hidden="true"></i>pypi
            </a>
          <% } %>
        </span>
      </p>
    </li>
  <% } %>
</ul>
</span>
```
